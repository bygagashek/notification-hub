APP_NAME=notification-hub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notification_hub
DB_USERNAME=hub
DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Delay in seconds before each retry; the number of values is the number of retries.
MESSAGING_RETRY_DELAYS=5,30,120
CONSUMER_PREFETCH=10
OUTBOX_RELAY_BATCH=100
